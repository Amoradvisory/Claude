{
  "name": "speed-car-relay",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "test": "vitest run && node --test test/diagnostic.test.mjs",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "diagnostic": "node scripts/diagnostic.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "4.156.0"
  }
}
