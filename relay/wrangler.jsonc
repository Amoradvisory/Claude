{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "speed-car-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "OWNER_STATE", "class_name": "OwnerState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OwnerState"] }
  ]
}
